<div class="container my-5" style="padding-top: 110px !important;">

    <!-- Optional: Page Title Section (Is se page professional lagta hai) -->
    <div class="row mb-5 text-center">
        <div class="col-12">
            <h2 class="fw-bold text-dark position-relative d-inline-block pb-2" style="letter-spacing: 0.5px;">
                Available Resources
                <span class="position-absolute bottom-0 start-50 translate-middle-x bg-primary rounded" style="width: 60px; height: 4px;"></span>
            </h2>
            <p class="text-muted small mt-2">Explore and access educational materials and PDFs below</p>
        </div>
    </div>

    <!-- Cards Grid -->
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <!-- Premium Card Styling -->
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden transition-hover" style="background: #ffffff; border: 1px solid #f0f0f0 !important;">

                    <!-- Top subtle accent bar for professional look -->
                    <div class="bg-primary" style="height: 5px; width: 100%;"></div>

                    <div class="card-body p-4 d-flex flex-column justify-content-between">

                        <div>
                            <!-- Card Title -->
                            <h5 class="card-title fw-bold text-dark mb-3 lh-base">
                                @item.Title
                            </h5>

                            <hr class="text-muted opacity-25 my-3">

                            <!-- Meta Information -->
                            <div class="card-text mb-4">
                                <div class="d-flex align-items-center mb-2">
                                    <span class="text-secondary small fw-semibold" style="min-width: 90px;">Author:</span>
                                    <span class="text-dark small fw-medium">@item.Author</span>
                                </div>

                                <div class="d-flex align-items-start mb-2">
                                    <span class="text-secondary small fw-semibold" style="min-width: 90px;">Subject:</span>
                                    <span class="badge bg-light text-primary border border-primary-subtle px-2.5 py-1.5 rounded-2 font-monospace small">
                                        @item.Subject?.SubjectId
                                    </span>
                                </div>

                                <div class="d-flex align-items-center mb-3">
                                    <span class="text-secondary small fw-semibold" style="min-width: 90px;">Year Level:</span>
                                    <span class="badge bg-secondary-subtle text-secondary px-2.5 py-1.5 rounded-2 small">
                                        Grade @item.YearLevelNavigation?.YearId
                                    </span>
                                </div>

                                <!-- Description Paragraph -->
                                <div class="mt-3">
                                    <span class="text-secondary small d-block fw-semibold mb-1">Description:</span>
                                    <p class="text-muted small mb-0 lh-sm text-truncate-2" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                        @item.Description
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- PDF Button Action -->
                        <div class="mt-auto pt-2">
                            <a href="@item.PdfLink" target="_blank" class="btn btn-outline-primary btn-sm w-100 fw-semibold py-2 rounded-3 shadow-none d-flex align-items-center justify-content-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-earmark-pdf-fill text-danger" viewBox="0 0 16 16">
                                    <path d="M5.523 12.424c.14-.082.293-.162.459-.238a7.878 7.878 0 0 1-.45.606c-.28.337-.498.516-.635.508-.077-.005-.14-.053-.182-.139-.047-.099-.045-.252.009-.437zm1.35-1.986c.12-.284.223-.591.302-.915a5.007 5.007 0 0 0-.115-.598c-.022-.096-.053-.251-.048-.322.006-.138.076-.234.148-.234.045 0 .093.037.124.101.093.19.055.421-.046.781a14.14 14.14 0 0 1-.363 1.188zm2.216.536a7.287 7.287 0 0 1 .59.442c.296.23.466.414.5.556.03.118.01.23-.07.317-.142.155-.44.155-.746-.015a3.313 3.313 0 0 1-.613-.62 11.32 11.32 0 0 1 .339-.68zm-2.022 1.588c.38-.247.79-.48 1.191-.68.307.79.544 1.481.676 2.016a5.596 5.596 0 0 1-.308-.016c-.436-.057-.794-.211-1.018-.428a.89.89 0 0 1-.141-.892z" />
                                    <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5v2z" />
                                </svg>
                                Open PDF Document
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Extra Optional CSS Effects (Cards par hover effect dalne ke liye) -->
<style>
    .transition-hover {
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

        .transition-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 1rem 3rem rgba(0,0,0,.1) !important;
        }
</style>  


