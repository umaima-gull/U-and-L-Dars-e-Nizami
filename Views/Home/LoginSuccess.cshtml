@{
    ViewData["Title"] = "Login Successful";
}

<div class="custom-breadcrumns border-bottom">
    <div class="container">
        <a asp-controller="Home" asp-action="Index">Home</a>
        <span class="mx-3 icon-keyboard_arrow_right"></span>
        <span class="current">Login Successful</span>
    </div>
</div>

<div class="site-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-7 text-center">
                <h2 class="mb-3">Successfully Login</h2>
                <p class="mb-4">Welcome @(ViewBag.UserName ?? "Customer"). Your customer side is ready.</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg px-5">Go to Storefront</a>
            </div>
        </div>
    </div>
</div>
