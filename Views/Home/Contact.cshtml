<!-- ✅ Added stronger top margin and padding to clear any heavy sticky/fixed headers -->
<div class="site-section ftco-subscribe-1 site-blocks-cover pb-5" style="background-image: linear-gradient(rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.55)), url('images/bg_1.jpg'); background-size: cover; background-position: center; min-height: 240px; display: flex; align-items: center; margin-top: 95px !important; padding-top: 60px !important;">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <!-- Premium Typography -->
                <h1 class="mb-0 text-white fw-extrabold tracking-wide text-uppercase" style="font-size: 50px; font-weight: 800; text-shadow: 0 4px 12px rgba(0,0,0,0.5);">
                    Contact Us
                </h1>
                <p class="text-white-50 small mt-2 mb-0">Get in touch with us or find our location on the map</p>
            </div>
        </div>
    </div>
</div>

<!-- ✅ Clean and Modern Breadcrumbs -->
<div class="custom-breadcrumbs py-3 bg-light border-bottom">
    <div class="container">
        <div class="d-flex align-items-center justify-content-start gap-2 fs-6">
            <a href="index.html" class="text-primary text-decoration-none fw-medium hover-underline">Home</a>
            <span class="text-muted opacity-50 small mx-1">&#10095;</span>
            <span class="text-secondary fw-semibold current">Contact</span>
        </div>
    </div>
</div>

<!-- ✅ Google Map Wrapper Section -->
<div class="site-section py-5 bg-white">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12">

                <!-- Section Subtitle -->
                <div class="text-center mb-4">
                    <span class="text-primary text-uppercase fw-bold tracking-wider small d-block mb-1">Our Location</span>
                    <h3 class="fw-bold text-dark">Find Us On Google Maps</h3>
                    <div class="bg-primary rounded mx-auto mt-2" style="width: 50px; height: 3px;"></div>
                </div>

                <!-- Modern Map Container with Soft Shadow and Rounded Corners -->
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden p-0">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d843.9775432498874!2d74.18793771900039!3d32.206651047885586!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x391f294b4e0c3e2d%3A0xe34ab8d752223386!2sMarkaz-E-Mustafa!5e0!3m2!1sen!2s!4v1777715439251!5m2!1sen!2s"
                            style="width:100%; height:480px; border:0; display:block;"
                            allowfullscreen=""
