<div class="custom-breadcrumns border-bottom">
    <div class="container">
        <a href="index.html">Home</a>
        <span class="mx-3 icon-keyboard_arrow_right"></span>
        <span class="current">Login</span>
    </div>
</div>

<div class="site-section">
    <div class="container">


        <div class="row justify-content-center">
            <form asp-controller="Home" asp-action="Login" method="post" class="col-md-5">
                @Html.AntiForgeryToken()
                <div class="row">
                    <div class="col-md-12 form-group">
                        <label for="loginId">User ID / Email</label>
                        <input type="text" id="loginId" name="loginId" class="form-control form-control-lg" required>
                    </div>
                    <div class="col-md-12 form-group">
                        <label for="password">Password</label>
                        <input type="password" id="password" name="password" class="form-control form-control-lg" required>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        <input type="submit" value="Log In" class="btn btn-primary btn-lg px-5">
                    </div>
                </div>
            </form>
        </div>
       

    </div>
</div>
